{
  "name": "@riftstats/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "node --import tsx --test test/database.integration.ts",
    "riot:smoke": "node --env-file=.env --import tsx scripts/riot-smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "close-with-grace": "^2.1.0",
    "fastify": "^5.2.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
