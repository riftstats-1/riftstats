# Kopiera till .env. Fyll endast i riktiga hemligheter i .env.
PORT=3000
LOG_LEVEL=info
MODE=api

# Postgres måste vara tillgänglig före API-start; migrationer körs automatiskt.
PGHOST=localhost
PGPORT=5432
PGUSER=riftstats
PGDATABASE=riftstats
PGPASSWORD=

# Riot-klienten används av fetchern och explicita manuella tester.
# HTTP-servern anropar inte Riot.
RIOT_API_KEY=
RIOT_RATE_PER_SEC=18
RIOT_RATE_PER_2MIN=90
